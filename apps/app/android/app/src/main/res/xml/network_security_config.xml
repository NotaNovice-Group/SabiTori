<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. No cleartext (http) traffic to any host. The app only contacts the update and
     error-report addresses it was built with, and only when the person switched them on. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
