# Optional network features of SabiTori. Copy this file to .env (never commit .env) and fill in
# what you want. Anything left empty is OFF and invisible: no setting, no code, no request.
# Even when set, a person must switch each one on in Settings. Messages are never sent.
# These are read at BUILD time; rebuild the app after changing them.

# Update channel: where signed packs/regions are downloaded from (https only, no query string).
# The directory holds index.json and index.json.sig made by `node scripts/updates-publish.mjs`.
# Needs BOTH this and the public key, or the feature stays off.
VITE_UPDATE_URL=
# Base64 Ed25519 PUBLIC key printed by `node scripts/updates-keygen.mjs`. The matching secret
# (UPDATE_SIGNING_KEY) never goes in this file or in the repo.
VITE_UPDATE_PUBLIC_KEY=

# Crash reports (Sentry). The DSN of a Sentry project, like https://<key>@o<id>.ingest.sentry.io/<project>.
# Reports have no messages, photos, user, request or breadcrumbs (see docs/updates.md).
VITE_SENTRY_DSN=
# Label shown in Sentry for this build, e.g. production or beta. Defaults to production.
VITE_SENTRY_ENVIRONMENT=

# Piper voices bundled inside the app (comma-separated pack tags). Default: fr.
# Other languages' voices can be delivered later through the signed update channel.
# SABITORI_BUNDLE_VOICES=fr
