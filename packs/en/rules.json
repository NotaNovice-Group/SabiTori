{
  "formatVersion": 1,
  "numbers": {
    "atoms": {
      "0": "zero",
      "1": "one",
      "2": "two",
      "3": "three",
      "4": "four",
      "5": "five",
      "6": "six",
      "7": "seven",
      "8": "eight",
      "9": "nine",
      "10": "ten",
      "11": "eleven",
      "12": "twelve",
      "13": "thirteen",
      "14": "fourteen",
      "15": "fifteen",
      "16": "sixteen",
      "17": "seventeen",
      "18": "eighteen",
      "19": "nineteen",
      "20": "twenty",
      "30": "thirty",
      "40": "forty",
      "50": "fifty",
      "60": "sixty",
      "70": "seventy",
      "80": "eighty",
      "90": "ninety"
    },
    "joiners": {
      "and": {
        "text": "and"
      },
      "hyphen": {
        "text": "-",
        "silent": true
      }
    },
    "join": [
      {
        "token": "hyphen"
      }
    ],
    "scales": [
      {
        "value": 100,
        "word": "hundred",
        "join": [
          {
            "token": "and",
            "when": {
              "remainderLt": 100
            }
          }
        ]
      },
      {
        "value": 1000,
        "word": "thousand",
        "join": [
          {
            "token": "and",
            "when": {
              "remainderLt": 100
            }
          }
        ]
      },
      {
        "value": 1000000,
        "word": "million",
        "join": [
          {
            "token": "and",
            "when": {
              "remainderLt": 100
            }
          }
        ]
      },
      {
        "value": 1000000000,
        "word": "billion",
        "join": [
          {
            "token": "and",
            "when": {
              "remainderLt": 100
            }
          }
        ]
      }
    ]
  },
  "money": {
    "template": "{amount} {currency}",
    "singularFor": [
      1
    ],
    "currencies": {
      "XAF": {
        "text": "CFA franc",
        "plural": "CFA francs"
      },
      "XOF": {
        "text": "CFA franc",
        "plural": "CFA francs"
      },
      "EUR": {
        "text": "euro",
        "plural": "euros"
      },
      "USD": {
        "text": "US dollar",
        "plural": "US dollars"
      }
    }
  },
  "dates": {
    "months": [
      "January",
      "February",
      "March",
      "April",
      "May",
      "June",
      "July",
      "August",
      "September",
      "October",
      "November",
      "December"
    ],
    "weekdays": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "templates": {
      "full": "{day} {month} {year}",
      "noYear": "{day} {month}",
      "fullWeekday": "{weekday} {day} {month} {year}",
      "noYearWeekday": "{weekday} {day} {month}"
    },
    "omitCurrentYear": true,
    "includeWeekday": false,
    "yearStyle": "century_pairs",
    "relative": {
      "today": "today",
      "tomorrow": "tomorrow",
      "yesterday": "yesterday"
    }
  },
  "phones": {
    "countryCode": "omit",
    "groups": [
      3,
      3,
      3
    ],
    "groupsByLength": {
      "4": [
        2,
        2
      ],
      "5": [
        3,
        2
      ],
      "6": [
        3,
        3
      ],
      "8": [
        4,
        4
      ]
    },
    "defaultGroupSize": 3,
    "read": "digits",
    "pause": {
      "text": ","
    }
  }
}